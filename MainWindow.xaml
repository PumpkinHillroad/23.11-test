<Window x:Class="Prct1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prct1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="2" Background="Aqua">
            <TextBlock Text="TestText" FontSize="50"/>
            <TextBlock Text="Testtext" FontSize="50"/>
            <TextBlock Text="Testtext" FontSize="50"/>
            <TextBlock Text="Testtext" FontSize="50"/>
        </StackPanel >
        <StackPanel Grid.Row="2" Grid.Column="3" Background="Aqua">
            <TextBlock Text="TestText" FontSize="50"/>
            <TextBlock Text="Testtext" FontSize="50"/>
            <TextBlock Text="Testtext" FontSize="50"/>
            <TextBlock Text="Testtext" FontSize="50"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Vertical" Background="BlanchedAlmond">
            <TextBlock Text="TopTextTest" FontSize="75" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Bottom" Background="red" Height="150" HorizontalAlignment="Stretch">
            <TextBlock  Text="BottomTextTest" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </StackPanel>
        <TextBlock Text="CenterTextTest" Grid.ColumnSpan="3" Grid.RowSpan="2" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
